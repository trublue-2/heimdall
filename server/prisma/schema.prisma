generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         String      @default("viewer") // "admin" | "viewer"
  createdAt    DateTime    @default(now())
  rateLimits   RateLimit[]
  devices      Device[]    @relation("DeviceAccess")
}

model Device {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  // Vorheriger Token bleibt nach Rotation kurz gültig (Grace) — verhindert, dass
  // ein "Setup-QR erzeugen" eine laufende Box sofort aussperrt (Token-Footgun).
  prevTokenHash   String?
  prevTokenExpiry DateTime?
  name        String        @default("Heimdall")
  createdAt   DateTime      @default(now())
  // Last reported state (from sync)
  locked      Boolean       @default(false)
  lockedSince DateTime?
  // Einmal-Marker: koppelt eine vom Menschen ausgelöste Öffnung an das nächste
  // Box-Sync-Event (kein Doppel-Eintrag). "early" → EARLY_OPEN, "silent" → kein Event.
  pendingOpenReason String?
  // Kontingent für vorzeitiges Notfall-Öffnen ("Trotzdem öffnen" ohne Passwort). Dekrementiert
  // je Early-Open; bei 0 blockiert (nur Keyholderin/Failsafes öffnen). Keyholder füllt auf.
  emergencyOpensLeft Int @default(3)
  battery     Int? // 0–100
  boltPos     String? // "OPEN" | "CLOSED" | "UNKNOWN"
  fwVersion   String?
  mac         String?  // WiFi-MAC der Box (Hardware-ID, von der Box im Sync gemeldet)
  // OTA-Freeze: Server lässt die OTA-Felder im Sync weg → Box updatet nicht. Not-Aus
  // für den Multi-Board-Rollout (verhindert versehentliches Flashen eines falschen Profils).
  otaDisabled Boolean  @default(false)
  // Server-Log: Box hängt ihr serielles Log bei jedem Sync an (auch schlafend, ~5 min).
  logToServer Boolean  @default(false)
  // MQTT-Push (Session-Fenster) ist Standard für jede Box: der Server liefert die Broker-Konfig
  // im Sync, sobald MQTT_PUBLIC_HOST gesetzt ist (nicht mehr pro Box abschaltbar). Ohne Broker-
  // Host bleibt die Box heartbeat-only.
  lastSyncAt  DateTime?
  wakeReason  String?
  wifiSsid    String?
  wifiRssi    Int?
  charging    Boolean?
  boxIp       String?
  primarySsid String? // Provisioning-Netz (knownSsids[0] der Box)
  // Zuletzt von der Box gemeldete WLAN-Namen (NVS: Primär + Extras), JSON-Array-String.
  // Nur zur Anzeige/Bereinigung (stale Netze sichtbar); die Box bleibt Quelle der Wahrheit.
  knownSsids  String?
  primaryLastUsedAt DateTime? // wann die Box zuletzt aufs Primär-Netz verbunden war
  // Operator-Wahl: dieses Netz bevorzugt verbinden (an die Box gepusht, Server gewinnt).
  // null = keine Server-Präferenz → Box behält ihre lokale /wifi-Wahl.
  preferredSsid String?
  // chastitytracker.ch-Anbindung (optional, pro Box). Box kennt den Tracker nicht —
  // der Server ist die Brücke. trackerSync=Feature-Flag; Instanz = welche Tracker-Deployment,
  // trackerUsername = Ziel-User. KEINE feste KG-Zuordnung: die Box ist generisch, welches KG
  // getragen wird weiss der Tracker aus der laufenden Session.
  trackerSync       Boolean @default(false)
  trackerInstanceId String? // welche Tracker-Instanz (multi-tenant: viele Sub/KH-Paare)
  trackerInstance   TrackerInstance? @relation(fields: [trackerInstanceId], references: [id], onDelete: SetNull)
  trackerUsername   String? // Tracker-Username (Ziel für Spur-2-Events + Sperrzeit-Pull)
  policy       LockPolicy?
  events       DeviceEvent[]
  users        User[]        @relation("DeviceAccess")
  wifiNetworks WifiNetwork[]
  logs         DeviceLog[]
}

// Eine chastitytracker.ch-Deployment, die dieser Heimdall-Server anspricht. Reine
// Verbindung: viele Boxen können auf dieselbe Instanz zeigen (KG- + Halsband-Box eines
// Paares). apiKey = das HEIMDALL_SYNC_SECRET dieser Instanz (Klartext — Server muss es senden).
model TrackerInstance {
  id        String   @id @default(cuid())
  name      String   // frei wählbarer Anzeigename (z.B. "trublue" / Paar-Name)
  baseUrl   String   // z.B. https://chastitytracker.ch
  apiKey    String   // Shared-Secret dieser Instanz
  createdAt DateTime @default(now())
  devices   Device[]
}

// Zusätzliche WLAN-Zugänge (über das Provisioning-Primärnetz hinaus).
// password wird nach Auslieferung an die Box genullt (Box meldet SSID als bekannt).
model WifiNetwork {
  id        String   @id @default(cuid())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  String
  ssid      String
  password  String? // null = bereits an die Box ausgeliefert
  createdAt DateTime @default(now())
  lastUsedAt DateTime? // wann die Box zuletzt auf dieses Netz verbunden war (aus Sync-wifiSsid)

  @@unique([deviceId, ssid])
}

// Fortlaufendes serielles Log der Box: bei aktivem Device.logToServer hängt die Box
// die neuen Ring-Puffer-Zeilen bei jedem Sync an. Retention: Server prunt je Gerät auf
// die letzten ~2000 Zeilen (siehe api/box/sync).
model DeviceLog {
  id        String   @id @default(cuid())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  String
  line      String
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model LockPolicy {
  id               String    @id @default(cuid())
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId         String    @unique
  lockUntil        DateTime?
  offlineOpenHours Int       @default(24)
  // "Einfach verschliessen" (ohne Zeit): zu, aber kein lockUntil. Box bleibt zu,
  // bis serverseitig geöffnet wird (jederzeit, kein Event). Failsafes bleiben aktiv.
  simpleLock       Boolean   @default(false)
  // Optionales Öffnungs-Passwort (bcrypt). Gesetzt → vorzeitiges Öffnen nur mit Passwort.
  openPasswordHash String?
  // Aus dem Tracker gezogene Keyholder-Absicht (Hybrid: strengere Zeit gewinnt).
  // Getrennt von lockUntil, damit die Heimdall-eigene Zeit nicht überschrieben wird.
  trackerLockUntil  DateTime? // timed Sperrzeit-Ende
  trackerSimpleLock Boolean   @default(false) // indefinite Sperrzeit → zu bis Keyholder öffnet
  // Reinigungspause: bis hierhin darf die Box TROTZ Sperrzeit offen sein (temporäre, vom
  // Tracker gewährte Öffnung; danach greift trackerLockUntil wieder). Öffnet nur FRÜHER →
  // sichere Richtung, lokale Failsafes bleiben unberührt (Safety-Invariante gewahrt).
  cleaningUntil     DateTime?
  updatedAt        DateTime  @updatedAt
}

model DeviceEvent {
  id        String   @id @default(cuid())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  String
  type      String // LOCKED | UNLOCKED | SYNC | FAILSAFE_OPEN | UNAUTHORIZED_OPEN
  timestamp DateTime
  reason    String?
  battery   Int?
  fwVersion String?
  createdAt DateTime @default(now())
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
  userId  String?
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AppMeta {
  key   String @id
  value String
}
