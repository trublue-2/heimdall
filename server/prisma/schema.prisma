generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         String      @default("viewer") // "admin" | "viewer"
  createdAt    DateTime    @default(now())
  rateLimits   RateLimit[]
  devices      Device[]    @relation("DeviceAccess")
}

model Device {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  // Vorheriger Token bleibt nach Rotation kurz gültig (Grace) — verhindert, dass
  // ein "Setup-QR erzeugen" eine laufende Box sofort aussperrt (Token-Footgun).
  prevTokenHash   String?
  prevTokenExpiry DateTime?
  name        String        @default("Heimdall")
  createdAt   DateTime      @default(now())
  // Last reported state (from sync)
  locked      Boolean       @default(false)
  lockedSince DateTime?
  // Einmal-Marker: koppelt eine vom Menschen ausgelöste Öffnung an das nächste
  // Box-Sync-Event (kein Doppel-Eintrag). "early" → EARLY_OPEN, "silent" → kein Event.
  pendingOpenReason String?
  battery     Int? // 0–100
  boltPos     String? // "OPEN" | "CLOSED" | "UNKNOWN"
  fwVersion   String?
  lastSyncAt  DateTime?
  wakeReason  String?
  wifiSsid    String?
  wifiRssi    Int?
  charging    Boolean?
  boxIp       String?
  primarySsid String? // Provisioning-Netz (knownSsids[0] der Box)
  // chastitytracker.ch-Anbindung (optional, pro Box). Box kennt den Tracker nicht —
  // der Server ist die Brücke. trackerSync=Feature-Flag; trackerUserId/-DeviceId = Mapping.
  trackerSync     Boolean @default(false)
  trackerUserId   String? // Tracker-User-id (Ziel für Spur-2-Events + Sperrzeit-Pull)
  trackerDeviceId String? // Tracker-Gerät am Schlüssel dieser Box (KG, Halsband, …)
  policy       LockPolicy?
  events       DeviceEvent[]
  users        User[]        @relation("DeviceAccess")
  wifiNetworks WifiNetwork[]
}

// Zusätzliche WLAN-Zugänge (über das Provisioning-Primärnetz hinaus).
// password wird nach Auslieferung an die Box genullt (Box meldet SSID als bekannt).
model WifiNetwork {
  id        String   @id @default(cuid())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  String
  ssid      String
  password  String? // null = bereits an die Box ausgeliefert
  createdAt DateTime @default(now())

  @@unique([deviceId, ssid])
}

model LockPolicy {
  id               String    @id @default(cuid())
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId         String    @unique
  lockUntil        DateTime?
  offlineOpenHours Int       @default(24)
  hardCapHours     Int?
  // "Einfach verschliessen" (ohne Zeit): zu, aber kein lockUntil. Box bleibt zu,
  // bis serverseitig geöffnet wird (jederzeit, kein Event). Failsafes bleiben aktiv.
  simpleLock       Boolean   @default(false)
  // Optionales Öffnungs-Passwort (bcrypt). Gesetzt → vorzeitiges Öffnen nur mit Passwort.
  openPasswordHash String?
  // Aus dem Tracker gezogene Keyholder-Absicht (Hybrid: strengere Zeit gewinnt, gekappt
  // durch hardCap). Getrennt von lockUntil, damit die Heimdall-eigene Zeit nicht überschrieben wird.
  trackerLockUntil  DateTime? // timed Sperrzeit-Ende
  trackerSimpleLock Boolean   @default(false) // indefinite Sperrzeit → zu bis Keyholder öffnet
  updatedAt        DateTime  @updatedAt
}

model DeviceEvent {
  id        String   @id @default(cuid())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  String
  type      String // LOCKED | UNLOCKED | SYNC | FAILSAFE_OPEN | UNAUTHORIZED_OPEN
  timestamp DateTime
  reason    String?
  battery   Int?
  fwVersion String?
  createdAt DateTime @default(now())
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
  userId  String?
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AppMeta {
  key   String @id
  value String
}
