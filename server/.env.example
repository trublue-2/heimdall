NEXTAUTH_SECRET=
# NextAuth v5 liest AUTH_URL bevorzugt; NEXTAUTH_URL als Fallback
AUTH_URL=https://heimdall.trublue.ch
NEXTAUTH_URL=https://heimdall.trublue.ch
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TRACKER_SYNC_ENABLED=false
TRACKER_URL=
TRACKER_API_KEY=

# ── MQTT-Push (Session-Fenster-Steuerung) ──────────────────────────────────
# Alles leer lassen → Bridge inaktiv, Box bleibt rein pull-basiert (Heartbeat).
MQTT_PUBLIC_HOST=mqtt.trublue.ch        # Host, den die Box im Sync bekommt (mqtts, Port 8883)
MQTT_BRIDGE_URL=mqtt://mosquitto:1883   # interner Broker-Zugang des Servers (Publish + Präsenz)
MQTT_BRIDGE_USER=heimdall-bridge        # privilegiertes Bridge-Konto (Superuser im go-auth-Backend)
MQTT_BRIDGE_PASS=                        # Bridge-Passwort setzen (gilt auch im go-auth-Backend)
